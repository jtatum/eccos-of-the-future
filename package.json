{
  "name": "eccos-of-the-future",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A human-facing web artwork containing an agent-native alternate reality game for the Earth Coincidence Control Office.",
  "scripts": {
    "dev": "npx --yes serve . -l 4173",
    "dev:sites": "node scripts/sync-sites-assets.mjs && vinext dev",
    "build": "node scripts/sync-sites-assets.mjs && vinext build",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs living-metaphor/tests/*.test.mjs",
    "verify": "node scripts/ecco.mjs verify",
    "check": "node scripts/check-site.mjs && node --test tests/*.test.mjs living-metaphor/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
